# Kosha environment. Copy to `.env` (never committed) and fill in.
# Docker:  cp .env.example .env, set KOSHA_SECRET_KEY, docker compose up -d
# Without Docker, also set DATABASE_URL (see backend/README.md).

# --- Required -----------------------------------------------------------------
# Signs the session cookie and encrypts API keys saved in the app. Generate one:  openssl rand -hex 32
# Keep it: changing it signs everyone out and makes saved keys unreadable.
KOSHA_SECRET_KEY=

# --- Recommended --------------------------------------------------------------
# The admin account, created (or updated) on every start, so the setup screen is
# skipped. Optional, with or without Docker: leave them empty and the first
# person to open the web app creates the admin on the setup screen (so set them
# when the address is reachable by others before you).
# Other people join by invite, or freely if the admin opens sign-ups (Settings).
KOSHA_ADMIN_EMAIL=
KOSHA_ADMIN_PASSWORD=
# Bearer token (the admin's) for the browser extension and MCP clients. Without it they
# cannot connect until you create a token in the web app (Settings).
# Generate one:  openssl rand -hex 32
KOSHA_API_TOKEN=

# --- Local use over plain http ------------------------------------------------
# The session cookie is HTTPS-only by default, so sign-in fails on
# http://localhost. Keep `false` here; set `true` behind an HTTPS reverse proxy.
KOSHA_COOKIE_SECURE=false
# `true` serves /api/docs and /api/openapi.json without signing in.
KOSHA_DEV=false
# Docker only: the host port of the web app.
#KOSHA_PORT=8080

# --- Optional API keys (Kosha starts and works without any of them) -------------
# Remove the leading # when you set one; leave unused ones commented out.
# Voyage embeddings. Without it: search is keyword-only (no semantic ranking).
#VOYAGE_API_KEY=
# TypeSafe Jev. Without it: the `jev` and `score_labels` pipeline stages and
# POST /api/jev/check do not work.
#TYPESAFE_API_KEY=
# OpenAI. Without it: Ask, image descriptions and video transcripts answer 503.
#OPENAI_API_KEY=
# A separate speech-to-text provider (optional): its key, name and model.
#KOSHA_TRANSCRIPTION_API_KEY=
#KOSHA_TRANSCRIPTION_PROVIDER=
#KOSHA_TRANSCRIPTION_MODEL=
# An admin can also save these keys in the web app (Settings); a saved key wins
# over the one here. A line that is present but empty counts as not set.

# --- Optional: landing page and demo -------------------------------------------
# `true`: signed-out visitors see the landing page instead of the sign-in form.
#KOSHA_LANDING=false
# Address of your public demo instance, linked from the landing page.
#KOSHA_DEMO_URL=
# Demo mode. ONLY for a separate demo instance with its own database
# (docs/DEMO.md): one published account; sign-up, tokens, captures, AI calls,
# permanent delete and admin routes are refused; the data is reset every night.
#KOSHA_DEMO=false
#KOSHA_DEMO_EMAIL=demo@example.com
#KOSHA_DEMO_PASSWORD=

# --- Optional: official X API bookmark sync (paid, off by default) -------------
#KOSHA_X_ACCESS_TOKEN=
#KOSHA_X_USER_ID=

# --- Without Docker only (Compose sets these itself) ---------------------------
#DATABASE_URL=postgresql+psycopg://user@localhost:5432/kosha
#TEST_DATABASE_URL=postgresql+psycopg://user@localhost:5432/kosha_test
#KOSHA_MEDIA_DIR=./data/media

# ==============================================================================
# Media storage and speech to text (kosha/storage.py, kosha/llm.py)
# ==============================================================================
# --- Optional: speech to text ---------------------------------------------------
# DeepInfra. With it, video transcripts use Whisper large-v3-turbo there
# ($0.0002 a minute); without it they use OpenAI ($0.0045 a minute).
#DEEPINFRA_API_KEY=

# --- Optional: media in an S3-compatible bucket ---------------------------------
# Default: files under KOSHA_MEDIA_DIR. These are the starting values; an admin
# can change them (and copy the files across) in the web app, which then wins.
# Works with AWS S3, Cloudflare R2, Backblaze B2, Hetzner, Garage, MinIO, SeaweedFS.
#KOSHA_STORAGE_BACKEND=s3
# Leave the endpoint out for AWS. R2: https://<account id>.r2.cloudflarestorage.com
#KOSHA_S3_ENDPOINT=
# "auto" for R2; the bucket's region elsewhere.
#KOSHA_S3_REGION=auto
#KOSHA_S3_BUCKET=
#KOSHA_S3_ACCESS_KEY_ID=
#KOSHA_S3_SECRET_ACCESS_KEY=
# Folder inside the bucket, e.g. kosha/media
#KOSHA_S3_PREFIX=
# true for Garage, MinIO and SeaweedFS (bucket in the path, not the host name).
#KOSHA_S3_PATH_STYLE=false
# proxy: the app streams files, the bucket stays private (default).
# presigned: the browser is sent to a short-lived bucket address.
#KOSHA_S3_SERVE_MODE=proxy
# With presigned: a public address of the bucket (CDN) to send browsers to instead.
#KOSHA_S3_PUBLIC_BASE_URL=
