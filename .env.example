# Kosha environment. Copy to `.env` (never committed) and fill in.
# Docker:  cp .env.example .env, set the three required values, docker compose up -d
# Without Docker, also set DATABASE_URL (see backend/README.md).

# --- Required -----------------------------------------------------------------
# Signs the session cookie. Generate one:  openssl rand -hex 32
KOSHA_SECRET_KEY=
# The single account, created (or updated) on every start.
KOSHA_ADMIN_EMAIL=
KOSHA_ADMIN_PASSWORD=

# --- Recommended --------------------------------------------------------------
# Bearer token for the browser extension and MCP clients. Without it they
# cannot connect until you create a token in the web app (Settings).
# Generate one:  openssl rand -hex 32
KOSHA_API_TOKEN=

# --- Local use over plain http ------------------------------------------------
# The session cookie is HTTPS-only by default, so sign-in fails on
# http://localhost. Keep `false` here; set `true` behind an HTTPS reverse proxy.
KOSHA_COOKIE_SECURE=false
# `true` serves /api/docs and /api/openapi.json without signing in.
KOSHA_DEV=false
# Docker only: the host port of the web app.
#KOSHA_PORT=8080

# --- Optional API keys (Kosha starts and works without any of them) -------------
# Remove the leading # when you set one; leave unused ones commented out.
# Voyage embeddings. Without it: search is keyword-only (no semantic ranking).
#VOYAGE_API_KEY=
# TypeSafe Jev. Without it: the `jev` and `score_labels` pipeline stages and
# POST /api/jev/check do not work.
#TYPESAFE_API_KEY=
# OpenAI. Without it: Ask, image descriptions and video transcripts answer 503.
#OPENAI_API_KEY=

# --- Optional: official X API bookmark sync (paid, off by default) -------------
#KOSHA_X_ACCESS_TOKEN=
#KOSHA_X_USER_ID=

# --- Without Docker only (Compose sets these itself) ---------------------------
#DATABASE_URL=postgresql+psycopg://user@localhost:5432/kosha
#TEST_DATABASE_URL=postgresql+psycopg://user@localhost:5432/kosha_test
#KOSHA_MEDIA_DIR=./data/media
